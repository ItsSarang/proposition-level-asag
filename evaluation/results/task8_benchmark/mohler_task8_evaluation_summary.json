    "n_previously_zero_now_positive": 93,
    "target_case_pointer_q6_1": [
      {
        "student_index": 0,
        "student_text": "Its a location in memory that contains the memory address of another location in memory that contains information.",
        "human_score": 5.0,
        "task7_grade": 1.8333,
        "v5_full_grade": 1.8333,
        "delta": 0.0
      },
      {
        "student_index": 1,
        "student_text": "A pointer is a variable that contains a memory address as its value.",
        "human_score": 5.0,
        "task7_grade": 0.0,
        "v5_full_grade": 5.0,
        "delta": 5.0
      },
      {
        "student_index": 2,
        "student_text": "A pointer is a variable which stores the address of another variable.",
        "human_score": 5.0,
        "task7_grade": 1.3333,
        "v5_full_grade": 1.3333,
        "delta": 0.0
      },
      {
        "student_index": 3,
        "student_text": "Pointers are variables that contain as their values memory addresses of other variables.",
        "human_score": 5.0,
        "task7_grade": 4.75,
        "v5_full_grade": 4.75,
        "delta": 0.0
      },
      {
        "student_index": 4,
        "student_text": "A data type whose value refers to another value stored elsewhere in the computer memory using its address.",
        "human_score": 4.5,
        "task7_grade": 0.0,
        "v5_full_grade": 0.0,
        "delta": 0.0
      }
    ],
    "target_case_merge_sort_q11_10": [
      {
        "student_index": 0,
        "student_text": "It uses the divide and conqure technique recursively and then when merging back together it compares each element together in a sorted list, this is done by reversing the divide and conquer technique",
        "human_score": 5.0,
        "task7_grade": 1.1171,
        "v5_full_grade": 1.1171,
        "delta": -0.0
      },
      {
        "student_index": 1,
        "student_text": "A merge sort works by removing all items to sepperate memory locations and merging them back together in order.",
        "human_score": 3.5,
        "task7_grade": 0.5417,
        "v5_full_grade": 0.5417,
        "delta": -0.0
      },
      {
        "student_index": 2,
        "student_text": "It divides the array into two halves, sorts each half, then merges the two halves together.",
        "human_score": 5.0,
        "task7_grade": 1.096,
        "v5_full_grade": 3.7753,
        "delta": 2.6793
      },
      {
        "student_index": 3,
        "student_text": "Divide into two sublists and then those sublists break into length 1, then merges the sublists sorted.",
        "human_score": 5.0,
        "task7_grade": 0.0,
        "v5_full_grade": 1.0952,
        "delta": 1.0952
      },
      {
        "student_index": 4,
        "student_text": "Merge sort uses the \"divide and conquer\" idea where it divides the array in half multiple times and then joins each element of the array back into one sorted array. This is one of the best sorting algorithms besides Quicksort.",
        "human_score": 5.0,
        "task7_grade": 0.0,
        "v5_full_grade": 1.5833,
        "delta": 1.5833
      }
    ]
  },
